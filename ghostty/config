theme = Patrick

font-family = "Iosevka Term SS12"
font-size = 13
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium
font-style-bold-italic = Bold
font-thicken = true
font-thicken-strength = 25
bold-color = bright

#window-decoration = none
#window-padding-x = 0
#window-padding-y = 0
background-opacity = 0.8
background-blur = macos-glass-regular
title = " "
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
window-save-state = always
bell-features = no-attention,no-title
confirm-close-surface = false
macos-shortcuts = deny
clipboard-trim-trailing-spaces = true

cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

# manipulate herdr panes (send prefix Ctrl+Y, then command)
keybind = cmd+d=text:\x19s
keybind = cmd+t=text:\x19n
keybind = cmd+w=text:\x19w
# navigate herdr tabs
keybind = opt+left=unbind
keybind = opt+right=unbind
# navigate herdr agents
keybind = opt+shift+left=unbind
keybind = opt+shift+right=unbind
# navigate herdr workspaces
keybind = opt+shift+up=unbind
keybind = opt+shift+down=unbind
# manipulate herdr workspaces (send prefix Ctrl+Y, then command)
keybind = opt+shift+n=text:\x19N
keybind = opt+shift+w=text:\x19D
# ctrl+l to clear screen - "clear_screen" doesn't work
keybind = ctrl+l=text:\x0c
# unbind new window
keybind = cmd+n=unbind
# unbind split down
keybind = shift+cmd+d=unbind
